# Docker Compose PostgreSQL credential. Use a strong random value in production.
POSTGRES_PASSWORD=

# Host interface and port for the Postgres service. Defaults bind on all
# interfaces so the DB is reachable from the host (psql / pgAdmin / local dev
# tools) and from other LAN devices. Set POSTGRES_BIND_ADDRESS=127.0.0.1 for a
# tighter security posture where only the host itself can connect.
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5432

# MinIO root credentials. These are consumed by docker-compose.yml:
#   - MINIO_ROOT_USER     <- MINIO_ACCESS_KEY (MinIO rejects empty strings)
#   - MINIO_ROOT_PASSWORD <- MINIO_SECRET_KEY
# The backend also forwards them via ISEStudio__Storage__AccessKey/SecretKey.
# Use a strong random value in production; defaults below are dev-only placeholders.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Backend system language for built-in model prompts: en | zh-CN.
# This is independent from each user's frontend language preference.
SYSTEM_LANGUAGE=en

# Public Streamable HTTP endpoint advertised to MCP clients.
MCP_PUBLIC_URL=http://localhost:8080/mcp

# Host interface and port exposed by the frontend container. Keep the default for a normal
# deployment; bind to 127.0.0.1 and choose another port for an isolated smoke test.
ISESTUDIO_BIND_ADDRESS=0.0.0.0
ISESTUDIO_PORT=8080
