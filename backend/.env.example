# OnToPilot .NET backend configuration. Copy to `backend/.env` and fill in.
#
# ASP.NET Core reads every value below via the EnvironmentVariables
# configuration provider; double-underscore (`__`) is the section
# delimiter. So `OnToPilot__SystemLanguage` maps to the
# `OnToPilot:SystemLanguage` option bound in Program.cs.

# --- ASP.NET Core hosting ---------------------------------------------------
# Standard ASP.NET Core host env. Production deployments should set
# this to "Production"; the compose file defaults to Production.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- Persistence (PostgreSQL) ------------------------------------------------
# Compose wires DATABASE_HOST / DATABASE_PORT etc. into the EF Core
# connection string via OnToPilot__Persistence__ConnectionString in
# docker-compose.yml. Local runs (no compose) can fall back to SQLite:
# OnToPilot__Persistence__Provider=sqlite
# OnToPilot__Persistence__SqliteConnection=Data Source=ontopilot.db
# OnToPilot__Persistence__Provider=npgsql
# OnToPilot__Persistence__ConnectionString=Host=localhost;Port=5432;Database=ontopilot;Username=postgres;Password=postgres

# --- System language ---------------------------------------------------------
# Built-in model prompt language: en | zh-CN. Independent from the frontend locale.
OnToPilot__SystemLanguage=en

# --- LLM / OpenRouter (required) ---------------------------------------------
# Get a key at https://openrouter.ai/. OntoPilot uses cheap models by default.
OnToPilot__LlmApiKey=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OnToPilot__ExtractModel=deepseek/deepseek-chat
OnToPilot__LlmTemperature=0.1
OnToPilot__LlmMaxTokens=4000
OnToPilot__EmbeddingModel=baai/bge-m3

# --- Auth --------------------------------------------------------------------
# A single admin account is seeded on first boot when the user table is empty.
# OnToPilot__AdminPassword is mandatory on first boot, must contain at least 12 characters.
OnToPilot__AdminUsername=admin
OnToPilot__AdminPassword=
# Optional: seed a deterministic, no-LLM demo knowledge system into an empty installation.
OnToPilot__SeedDemoData=false
# Set true when serving over HTTPS so the session cookie gets the Secure flag.
OnToPilot__CookieSecure=false

# --- CORS (frontend origins allowed to call the API) -------------------------
# JSON list. Add your deployed frontend origin here for production.
OnToPilot__CorsOrigins=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Object storage (MinIO / S3-compatible) ---------------------------------
# Wired by docker-compose.yml against the `minio` service. Local runs
# can point at a real MinIO instance via these overrides.
OnToPilot__Storage__Endpoint=minio:9000
OnToPilot__Storage__AccessKey=ontopilot
OnToPilot__Storage__SecretKey=ontopilot123
OnToPilot__Storage__Bucket=ontopilot-blobs
OnToPilot__Storage__UseSsl=false

# --- MCP --------------------------------------------------------------------
# Public Streamable HTTP endpoint advertised to MCP clients.
MCP_PUBLIC_URL=http://localhost:8080/mcp
OnToPilot__PublicHost=localhost
# Default and maximum lifetime for user-delegated MCP tokens.
OnToPilot__McpTokenTtlMinutes=60
OnToPilot__McpMaxTokenTtlMinutes=43200

# --- Direct RDF import -------------------------------------------------------
OnToPilot__RdfImportMaxBytes=26214400     # 25 MiB upload limit
OnToPilot__RdfImportMaxTriples=250000     # parsed statement ceiling
