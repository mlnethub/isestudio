{
  "$schema": "https://ontopilot.io/schemas/normalization.v1.json",
  "description": "Allowlist of dynamic fields stripped by the differential contract runner before comparing Python vs .NET response bodies. The list is applied recursively to every nested object and every array entry. Business fields are NEVER removed.",
  "allowlist": [
    "created_at",
    "updated_at",
    "deleted_at",
    "trace_id",
    "request_id",
    "session_id",
    "etag",
    "last_modified",
    "timestamp",
    "ts",
    "token",
    "access_token",
    "refresh_token",
    "trace_token",
    "session_token",
    "bearer_token",
    "api_key",
    "password",
    "*_token",
    "*_at",
    "*_secret"
  ],
  "headerAllowlist": [
    "date",
    "x-request-id",
    "x-trace-id",
    "x-correlation-id",
    "set-cookie",
    "x-ratelimit-remaining",
    "x-ratelimit-reset"
  ]
}
