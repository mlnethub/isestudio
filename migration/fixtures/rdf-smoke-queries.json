[
  {
    "name": "all-quads",
    "query": "SELECT * WHERE { GRAPH ?g { ?s ?p ?o } } ORDER BY ?g ?s ?p ?o"
  },
  {
    "name": "tbox-only",
    "query": "SELECT * WHERE { GRAPH <urn:ontopilot:test:tbox> { ?s ?p ?o } } ORDER BY ?s ?p ?o"
  },
  {
    "name": "abox-only",
    "query": "SELECT * WHERE { GRAPH <urn:ontopilot:test:abox> { ?s ?p ?o } } ORDER BY ?s ?p ?o"
  },
  {
    "name": "count-by-graph",
    "query": "SELECT ?g (COUNT(*) AS ?c) WHERE { GRAPH ?g { ?s ?p ?o } } GROUP BY ?g ORDER BY ?g"
  }
]
