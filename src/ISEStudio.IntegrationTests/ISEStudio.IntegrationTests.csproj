<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- NU1903 (SSH.NET 2024.2.0 transitive from Testcontainers.PostgreSql)
         is a known vulnerability advisory that the project does not control.
         Suppress so -warnaserror builds stay usable.
         CS0618 (Testcontainers.PostgreSqlBuilder parameterless constructor is
         obsolete) is a pre-existing pattern in PostgresSchemaTests and
         ContainerSmokeFixture. Both are outside the Stage-6 Migration slice
         (Persistence/ and Deployment/) so Task 1 must not touch them; suppress
         here so the data-cutover build can stay -warnaserror. -->
    <NoWarn>$(NoWarn);NU1903;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Testcontainers" Version="4.14.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.Minio" Version="4.14.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ISEStudio\ISEStudio.csproj" />
    <ProjectReference Include="..\ISEStudio.Migration\ISEStudio.Migration.csproj" />
  </ItemGroup>

</Project>