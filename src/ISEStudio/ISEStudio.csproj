<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- DoclingDotNet 1.2.0 transitively pins bblanchon.PDFium to >= 135.0.7024; NuGet's
         auto-bump to 135.0.7033 is harmless but reports NU1603. NU1603 is reported at the
         project level during restore, so it cannot be suppressed via a per-PackageReference
         `<NoWarn>` attribute (it is not a build warning). Suppressing it here is the
         correct scope: only this project depends on DoclingDotNet, and any other NU1603
         finding would be unrelated. -->
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- IdentityModel 家族必须整体统一版本:JwtBearer 10.0.0 传递解析 JsonWebTokens 8.0.1,
         与 Tokens 8.22.0 运行时 API 不兼容(JsonWebToken.ReadToken → Base64UrlEncoder.Decode
         抛 MissingMethodException)。显式引用 Protocols.OpenIdConnect 会把全家桶拉到 8.22.0。 -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Oxigraph" Version="0.5.8" />
    <PackageReference Include="Oxigraph.Extensions.DotNetRDF" Version="0.5.8" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageReference Include="dotNetRDF" Version="3.5.2" />
    <PackageReference Include="DoclingDotNet" Version="1.2.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.10.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ISEStudio.Application\ISEStudio.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Ontology\Shapes\tbox-shapes.ttl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Storage wrappers (HashingStream, ResponseOwningStream) are internal
         so MinioBlobStore's contract stays the IBlobStore surface; expose
         them to the unit test project so the streaming/disposal behavior
         can be asserted without spinning up MinIO. -->
    <InternalsVisibleTo Include="ISEStudio.Tests" />
  </ItemGroup>

</Project>
