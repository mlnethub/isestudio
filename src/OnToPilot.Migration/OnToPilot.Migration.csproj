<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- OutputType=Exe so the PowerShell wrapper can invoke
         `dotnet OnToPilot.Migration.dll blobs ...` against the migration
         assembly directly. The console host lives in Blobs/Program.cs and
         dispatches on the first argument. Library consumers (tests, the
         API host when running in-process) call BlobMigrationCommand
         directly without going through the host. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>OnToPilot.Migration</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Logging.* pinned to the highest version that
         satisfies the transitive chain through OnToPilot (which pulls
         Microsoft.Extensions.AI 10.7.0 -> Microsoft.Extensions.Hosting.Abstractions
         10.0.10 -> Microsoft.Extensions.Logging.Abstractions >= 10.0.10).
         NU1605 downgrade detection fails the restore otherwise. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <!-- AWSSDK.S3 is what the existing MinioBlobStore uses; the blob
         migration entry point builds an AmazonS3Client from CLI args so
         the PowerShell wrapper can wire MinIO without forcing the rest
         of the project to take a transitive SDK dependency. -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.*" />
    <!-- Oxigraph 0.5.8: the data-cutover RDF layer (Task 2) consumes the
         same disk-backed store wrapper the rest of OnToPilot already uses.
         The Migration project deliberately does NOT depend on
         Oxigraph.Extensions.DotNetRDF — that package is only needed when
         the .NET code is talking RDF terms to dotNetRDF. Migration talks
         Oxigraph directly (Store, Quad, RdfFormat). -->
    <PackageReference Include="Oxigraph" Version="0.5.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnToPilot.Application\OnToPilot.Application.csproj" />
    <!-- Blob migration (Task 3) reuses MinioBlobStore + IBlobStore + BlobKey
         from the Storage layer; referencing the host project keeps the
         existing tested primitives in play without copying any code. -->
    <ProjectReference Include="..\OnToPilot\OnToPilot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The migration SQL files live under <repo-root>/migrations/SqlAlchemyToEfCore
         so they are shared with the rehearsal / cutover orchestration
         (Task 4) and version-controlled next to the .NET source. Copy
         them next to the executing assembly so the runtime can load
         them without filesystem assumptions. -->
    <Content Include="..\..\migrations\SqlAlchemyToEfCore\*.sql" Link="migrations\SqlAlchemyToEfCore\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
