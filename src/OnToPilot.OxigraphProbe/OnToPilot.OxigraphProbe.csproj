<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- NU1903 (SSH.NET 2024.2.0 transitive from Testcontainers.PostgreSql)
         is a known vulnerability advisory that the project does not control.
         Suppress so -warnaserror builds stay usable. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Oxigraph" Version="0.5.8" />
    <PackageReference Include="Oxigraph.Extensions.DotNetRDF" Version="0.5.8" />
    <PackageReference Include="dotNetRDF" Version="3.5.2" />
  </ItemGroup>

</Project>
