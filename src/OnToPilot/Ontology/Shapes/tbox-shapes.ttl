@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix op:    <http://ontopilot.local/vocab#> .

# ---------------------------------------------------------------------------
# TBox-level SHACL shapes.
#
# These shapes are supplementary — they exist to surface constraint
# violations that escape the imperative Guard checks in TBoxGuard.cs.
# They MUST NOT be treated as authoritative: the role-evidence and
# normalization rules in TBoxGuard.cs win whenever they disagree.
# ---------------------------------------------------------------------------

op:OntologyShape
    a sh:NodeShape ;
    sh:targetClass owl:Ontology ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every ontology (named graph) must have an rdfs:label."@en ;
    ] .

op:OwlClassShape
    a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every owl:Class must have an rdfs:label so the UI can render it."@en ;
    ] .

op:OwlObjectPropertyShape
    a sh:NodeShape ;
    sh:targetClass owl:ObjectProperty ;
    sh:property [
        sh:path rdfs:range ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Every owl:ObjectProperty must declare an rdfs:range (class IRI)."@en ;
    ] .

op:OwlDatatypePropertyShape
    a sh:NodeShape ;
    sh:targetClass owl:DatatypeProperty ;
    sh:property [
        sh:path rdfs:range ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Every owl:DatatypeProperty must declare an rdfs:range (xsd datatype)."@en ;
    ] .

op:OwlNamedIndividualShape
    a sh:NodeShape ;
    sh:targetClass owl:NamedIndividual ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every owl:NamedIndividual should carry an rdfs:label."@en ;
    ] .

op:SkosConceptShape
    a sh:NodeShape ;
    sh:targetClass <http://www.w3.org/2004/02/skos/core#Concept> ;
    sh:property [
        sh:path <http://www.w3.org/2004/02/skos/core#prefLabel> ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every skos:Concept must have at least one skos:prefLabel."@en ;
    ] ;
    sh:property [
        sh:path <http://www.w3.org/2004/02/skos/core#inScheme> ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Every skos:Concept must belong to exactly one skos:ConceptScheme."@en ;
    ] .